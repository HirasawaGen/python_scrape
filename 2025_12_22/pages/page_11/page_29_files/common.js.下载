function SwiperHandler(className, pagination = true) {
    if (!document.querySelector(className)) return;
    if (document.querySelectorAll(className + '>div .swiper-slide').length > 1) {
        InitSwiper(className, pagination)
    } else {
        let observer = new MutationObserver((mutationsList) => {
            if (document.querySelectorAll(className + '>div .swiper-slide').length > 1) {
                clearTimeout(timer);
                var timer = setTimeout(() => {
                    InitSwiper(className, pagination)
                })
            }
            observer.disconnect()
        })
        observer.observe($(`${className}`)[0], { childList: true, subtree: true })
    }
}


function InitSwiper(className, pagination = true) {
    var mySwiper = new Swiper(`${className}`, {
        direction: 'horizontal',
        loop: true,

        autoplay: {
            disableOnInteraction: false,
            delay: 6000
        },
        pagination: {
            el: '.swiper-pagination',
            bulletClass: pagination ? 'currentBullet' : '.',
            bulletActiveClass: 'activeCurrentBullet',
            clickable: true,
        }
    })
}

function MoveActiveHandler(opt) {
    let { moveEl, active, box, onChange, eventType = 'click', moveElWidth = '100%' } = opt
    let calc = parseFloat(moveElWidth) / 100
    $(box).append($(`<i class=${moveEl.slice(1)}></i>`))
    let els = Array.from($(box).children()).filter(item => !$(item).hasClass(moveEl.slice(1)))
    $(`${box} ${moveEl}`).css({
        width: $(els[0]).innerWidth() + 'px',
        left: els[0].offsetLeft + 'px'
    })
    $(els)[eventType](function () {
        let elWidth = $(this).innerWidth()
        let posLeft = $(this)[0].offsetLeft
        $(els).removeClass(active)
        $(this).addClass(active)
        $(`${box} ${moveEl}`).css({
            width: elWidth * calc + 'px',
            left: moveElWidth === '100%' ? posLeft + 'px' : posLeft + ((elWidth - elWidth * calc) / 2) + 'px'
        })
        if (onChange && typeof onChange === "function") onChange($(this).index())
    })
}

