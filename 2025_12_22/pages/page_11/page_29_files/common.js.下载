function DropDown(el, eventType, showCb, clickCb) {
    el[eventType](function () {
        if ($(this).hasClass('hasChildren')) $(this).addClass('up')
        const ul = $(this).find('ul')
        ul.addClass('show animate__animated animate__fadeInUp animate__faster')
        if (ul.length > 0 && ul.offset().left + ul.width() > $(window).width() - 50) {
            ul.addClass('toLeft')
        }
        if (showCb && typeof showCb === "function") showCb(true)
    }).mouseleave(function (e) {
        if ($(this).hasClass('hasChildren')) $(this).removeClass('up')
        const ul = $(this).find('ul')
        ul.removeClass('show animate__animated animate__fadeInUp animate__faster')
        if (showCb && typeof showCb === "function") showCb(false)
        if (ul.hasClass('toLeft')) ul.removeClass('toLeft')
    })
    el.find('ul').children().each(function () {
        $(this).click(function (e) {
            e.stopPropagation()
            el.find('ul').removeClass('show animate__animated animate__fadeInUp animate__faster')
            if (clickCb && typeof clickCb === "function") clickCb($(this).text())
        })
    })
}

