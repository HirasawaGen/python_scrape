async function loopMove(moveEl, showCount, mouseStop = false, byframe = false) {
    if (moveEl.length === 0) return;
    var timer = null
    const childLen = moveEl.children().length
    if (childLen <= showCount) return
    if (childLen % showCount !== 0) {
        const addCount = showCount - (childLen % showCount)
        for (let i = 0; i < addCount; i++) {
            moveEl.append(moveEl.children().eq(i).clone())
        }
    }
    let ItemHeight = moveEl.children().eq(0).innerHeight()
    let ItemWidth = moveEl.children().eq(0).innerWidth()
    if (ItemWidth * showCount > moveEl.innerWidth()) {
        ItemHeight = Math.ceil(moveEl.innerWidth() / ItemWidth) * ItemHeight
    }

    if (byframe) {
        let animate_id
        let distance = 0
        let lastUpdateTime = 0
        function doMove() {
            let current_time = Date.now()
            if (current_time - lastUpdateTime > 10) {
                distance += 1
                moveEl.css({
                    'transform': 'translateY(' + -distance + 'px)'
                })
                lastUpdateTime = current_time
            }
            if (distance >= 37) {
                // cancelAnimationFrame(animate_id)
                insert_element()
                moveEl.css({
                    'transform': 'translateY(0px)'
                })
                distance = 0
                //animate_id = requestAnimationFrame(doMove)
            }
            animate_id = requestAnimationFrame(doMove)
        }
        animate_id = requestAnimationFrame(doMove)
        moveEl.mouseenter(function () {
            cancelAnimationFrame(animate_id)
        }).mouseleave(function () {
            animate_id = requestAnimationFrame(doMove)
        })
    } else {
        timer = setInterval(move_handler, 3000)
    }


    if (mouseStop && !byframe) {
        moveEl.mouseenter(function () {
            clearInterval(timer)
            timer = null
        }).mouseleave(function () {
            timer = setInterval(move_handler, 3000)
        })
    }

    function move_handler() {
        moveEl.css({
            'transition': 'all 0.4s linear',
            'transform': 'translateY(' + -ItemHeight + 'px)'
        })
    }


    if (!byframe) {
        moveEl[0].addEventListener('webkitTransitionEnd', function () {
            insert_element()
            moveEl.css({
                'transition': 'none',
                'transform': 'translateY(0)'
            })
        })
    }



    function insert_element() {
        const childrenList = moveEl.children()
        for (let i = 0; i < showCount; i++) {
            moveEl.append(childrenList.eq(i))
        }
    }


}

